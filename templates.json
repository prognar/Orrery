{
 "_doc": "Service templates. match: names/tags = regex on guest name/tags; http = [{port, path, re, scheme?}] fingerprint (regex on <title>+body+Server header); ports = TCP ports that hint at the service. look = planet body in bodies3d.js ('globe' = drawn by traits3d.js, 'generic' = plain planet). tier = default prominence (active|watch|quiet|hidden). trait = live-data integration key (null = look only). creds = what the setup UI asks for to enable live data. media = can be promoted to the external media giant. ours = runs in the reference lab.",
 "version": 1,
 "categories": [
  "media",
  "network",
  "home",
  "storage",
  "monitoring",
  "productivity",
  "infra",
  "security",
  "dev",
  "games",
  "ai"
 ],
