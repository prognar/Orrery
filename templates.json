  {
   "key": "plex",
   "label": "Plex Media Server",
   "category": "media",
   "look": "telescope",
   "tier": "active",
   "trait": "plex",
   "media": true,
   "ours": true,
   "match": {
    "names": [
     "^plex",
     "plex$"
    ],
    "ports": [
     32400
    ],
    "http": [
     {
      "port": 32400,
      "path": "/identity",
      "re": "MediaContainer"
     }
    ]
   },
   "creds": [
    {
     "key": "token",
     "label": "X-Plex-Token",
     "hint": "plex.tv → any item → Get Info → View XML; token= in the URL"
    }
   ]
  },
